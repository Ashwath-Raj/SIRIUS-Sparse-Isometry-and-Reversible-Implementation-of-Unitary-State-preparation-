{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SparsePrep Machine Manifest",
  "type": "object",
  "required": ["manifest_version", "machine_id", "captured_at_utc", "os", "python", "cpu", "memory", "gpu_devices", "software"],
  "properties": {
    "manifest_version": {"const": "1.0.0"},
    "machine_id": {"type": "string"},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "os": {"type": "object"}, "python": {"type": "object"}, "cpu": {"type": "object"},
    "memory": {"type": "object"}, "gpu_devices": {"type": "array", "items": {"type": "object"}},
    "software": {"type": "object"}, "notes": {"type": "string"}
  },
  "additionalProperties": false
}
